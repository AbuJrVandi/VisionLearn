# VisionLearn Backend Configuration
# Copy this file to .env and fill in your API key

# Hugging Face API (free) - https://huggingface.co/settings/tokens
# No organisation or approval required — just create a free account.
HF_API_KEY=
HF_MODEL=mistralai/Mistral-7B-Instruct-v0.3

# If no HF_API_KEY is set, the chat system uses a built-in offline
# educational knowledge base (pre-written subject responses).
# Speech-to-text and browser microphone still work without a key.

# Debug mode (set to True for development)
DEBUG=True
